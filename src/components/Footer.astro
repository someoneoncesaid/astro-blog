					</a>
					<a href="https://m.webtoo.ls/@astro" target="_blank" rel="noopener noreferrer" aria-label="Mastodon" title="Mastodon">
						<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a3.614 3.614 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522c0-.859.22-1.541.66-2.046.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.983L8 4.39l.417-.695c.429-.655 1.077-.983 1.934-.983.74 0 1.336.259 1.791.764.442.505.661 1.187.661 2.046v4.203z" /></svg>
					</a>
					<a href="https://twitter.com/astrodotbuild" target="_blank" rel="noopener noreferrer" aria-label="Twitter" title="Twitter">
						<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z" /></svg>
					</a>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<span>© {today.getFullYear()} {SITE_TITLE}. All rights reserved.</span>
			<span class="footer-colophon">Built with Astro · Ink &amp; Paper</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 6rem;
		padding: 3.5rem 0 1.75rem;
		border-top: 1px solid var(--line-strong);
		background: var(--surface-soft);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr;
		gap: 3rem;
		padding-bottom: 3rem;
	}

	.footer-logo {
		margin: 0 0 0.5rem;
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: 1.6rem;
		font-weight: 600;
	}

	.footer-desc {
		max-width: 24rem;
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.footer-nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
	}

	.footer-nav .eyebrow,
	.footer-social .eyebrow {
		margin-bottom: 0.5rem;
	}

	.footer-nav a {
		color: var(--ink-soft);
		font-size: 0.9rem;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-nav a:hover {
		color: var(--accent);
	}

	.social-links {
		display: flex;
		gap: 0.6rem;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border: 1px solid var(--line-strong);
		border-radius: 50%;
		color: var(--accent);
		text-decoration: none;
		transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
	}

	.social-links svg {
		width: 16px;
		height: 16px;
	}

	.social-links a:hover {
		color: var(--accent-strong);
		border-color: var(--accent);
		background: var(--surface);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.8rem;
		letter-spacing: 0.02em;
	}

	.footer-colophon {
		font-family: var(--font-serif);
		font-style: italic;
	}

	@media (max-width: 720px) {
		.site-footer {
			margin-top: 4rem;
			padding-top: 2.5rem;
		}
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
		.footer-bottom {
			flex-direction: column;
			gap: 0.35rem;
		}
	}
</style>
