---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<p class="footer-logo">{SITE_TITLE}</p>
				<p class="footer-desc">{SITE_DESCRIPTION}</p>
			</div>

			<nav class="footer-nav" aria-label="页脚导航">
				<p class="eyebrow">Navigate</p>
				<a href="/">首页</a>
				<a href="/blog">文章归档</a>
				<a href="/summaries">图文摘要</a>
				<a href="/about">关于我</a>
				<a href="/rss.xml">RSS 订阅</a>
			</nav>

			<div class="footer-social">
				<p class="eyebrow">Elsewhere</p>
				<div class="social-links">
					<a href="https://github.com/withastro/astro" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
