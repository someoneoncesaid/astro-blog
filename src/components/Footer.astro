---
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_LINKS } from '../consts';
import SocialLinks from './SocialLinks.astro';
import SiteMetrics from './SiteMetrics.astro';
import { withBase } from '../utils/url';

const today = new Date();
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<p class="footer-logo">{SITE_TITLE}</p>
				<p class="footer-desc">{SITE_DESCRIPTION}</p>
				<SiteMetrics />
			</div>

			<nav class="footer-nav" aria-label="页脚导航">
				<p class="eyebrow">Navigate</p>
				<a href={withBase('/')}>首页</a>
				<a href={withBase('/blog')}>文章归档</a>
				<a href={withBase('/summaries')}>图文摘要</a>
				<a href={withBase('/rss.xml')}>RSS 订阅</a>
			</nav>

			<div class="footer-social">
				<p class="eyebrow">Elsewhere</p>
				<SocialLinks />
			</div>
		</div>

		<div class="footer-bottom">
			<span>© {today.getFullYear()} {SITE_TITLE}. All rights reserved.</span>
			<span class="footer-colophon">Built with Astro · Ink &amp; Paper</span>
		</div>
	</div>

	<dialog id="wechat-dialog" class="wechat-dialog" aria-labelledby="wechat-dialog-title">
		<div class="wechat-panel">
			<p class="eyebrow" id="wechat-dialog-title">WeChat · 微信公众号</p>
			<div class="wechat-qr">
				<img src={withBase(SOCIAL_LINKS.wechatQr)} width={258} height={258} alt="微信公众号二维码" />
			</div>
			<p class="wechat-hint">扫码关注「{SITE_TITLE}」</p>
			<button class="wechat-close" type="button" id="wechat-close">关闭</button>
		</div>
	</dialog>
</footer>

<script>
	const wechatDialog = document.getElementById('wechat-dialog') as HTMLDialogElement | null;
	const wechatTriggers = document.querySelectorAll<HTMLButtonElement>('[data-wechat-open]');
	const wechatClose = document.getElementById('wechat-close');

	wechatTriggers.forEach((trigger) => {
		trigger.addEventListener('click', () => wechatDialog?.showModal());
	});
	wechatClose?.addEventListener('click', () => wechatDialog?.close());
	wechatDialog?.addEventListener('click', (event) => {
		if (event.target === wechatDialog) wechatDialog.close();
	});
</script>

<style>
	.site-footer {
		margin-top: 6rem;
		padding: 3.5rem 0 1.75rem;
		border-top: 1px solid var(--line-strong);
		background: var(--surface-soft);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr;
		gap: 3rem;
		padding-bottom: 3rem;
	}

	.footer-logo {
		margin: 0 0 0.5rem;
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: 1.6rem;
		font-weight: 600;
	}

	.footer-desc {
		max-width: 24rem;
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.footer-nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
	}

	.footer-nav .eyebrow,
	.footer-social .eyebrow {
		margin-bottom: 0.5rem;
	}

	.footer-nav a {
		color: var(--ink-soft);
		font-size: 0.9rem;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-nav a:hover {
		color: var(--accent);
	}

	/* ---------- 微信公众号二维码 ---------- */

	.wechat-dialog {
		width: min(86vw, 340px);
		max-width: none;
		padding: 0;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-lg);
		background: var(--surface);
		color: var(--ink);
		box-shadow: var(--shadow-md);
	}

	.wechat-dialog::backdrop {
		background: rgba(18, 20, 25, 0.55);
		backdrop-filter: blur(2px);
	}

	.wechat-panel {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		padding: 1.6rem 1.4rem 1.4rem;
		text-align: center;
	}

	.wechat-panel .eyebrow {
		margin: 0;
		color: var(--muted);
	}

	.wechat-qr {
		padding: 0.55rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--paper);
	}

	.wechat-qr img {
		width: auto;
		max-width: 100%;
		height: auto;
		border-radius: 2px;
	}

	.wechat-hint {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.84rem;
	}

	.wechat-close {
		padding: 0.5rem 1.1rem;
		border: 1px solid var(--line-strong);
		border-radius: 100px;
		background: transparent;
		color: var(--ink);
		font-family: var(--font-sans);
		font-size: 0.78rem;
		cursor: pointer;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.wechat-close:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.8rem;
		letter-spacing: 0.02em;
	}

	.footer-colophon {
		font-family: var(--font-serif);
		font-style: italic;
	}

	@media (max-width: 720px) {
		.site-footer {
			margin-top: 4rem;
			padding-top: 2.5rem;
		}
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
		.footer-bottom {
			flex-direction: column;
			gap: 0.35rem;
		}
	}
</style>
