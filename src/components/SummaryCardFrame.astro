---
import { withBase } from '../utils/url';

interface SummaryCard {
	type: "html" | "image";
	src: string;
	title?: string;
	width?: number;
	height?: number;
}

interface Props {
	card: SummaryCard;
	alt: string;
	loading?: "eager" | "lazy";
	class?: string;
}

const { card, alt, loading = "lazy", class: className } = Astro.props;
const width = card.width ?? 1080;
const height = card.height ?? 1440;
---

<div
	class:list={["summary-frame", className]}
	style={`aspect-ratio: ${width} / ${height};`}
	data-card-type={card.type}
>
	{
		card.type === "html" ? (
			<iframe
				src={withBase(card.src)}
				title={alt}
				loading={loading}
				scrolling="no"
				tabindex="-1"
				aria-hidden="true"
			/>
		) : (
			<img
				src={withBase(card.src)}
				alt={alt}
				width={width}
				height={height}
				loading={loading}
				decoding="async"
			/>
		)
	}
</div>

<style>
	.summary-frame {
		position: relative;
		width: 100%;
		overflow: hidden;
		background: #faf8f3;
		border: 1px solid var(--line);
		border-radius: 2px;
		box-shadow: var(--shadow-md);
	}

	.summary-frame iframe,
	.summary-frame img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.summary-frame iframe {
		/* 卡片是静态画面，点击交给外层链接 / 按钮处理 */
		pointer-events: none;
	}

	.summary-frame img {
		object-fit: cover;
	}
</style>
