---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils/url';
---

<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href={withBase('/')} aria-label={`${SITE_TITLE} 首页`}>
			<span class="brand-mark" aria-hidden="true"></span>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>

		<nav class="nav" aria-label="主导航">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/summaries">图文摘要</HeaderLink>
		</nav>

		<div class="header-actions">
			<a class="icon-link" href={withBase('/rss.xml')} aria-label="RSS 订阅" title="RSS 订阅">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
					<path d="M4 11a9 9 0 0 1 9 9" stroke-linecap="round" />
					<path d="M4 4a16 16 0 0 1 16 16" stroke-linecap="round" />
					<circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none" />
				</svg>
			</a>
			<button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
				<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round" />
				</svg>
				<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
					<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke-linejoin="round" />
				</svg>
			</button>
		</div>
	</div>
</header>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		document
			.getElementById('favicon')
			?.setAttribute(
				'href',
				`${import.meta.env.BASE_URL}${next === 'dark' ? 'favicon-dark.svg' : 'favicon.svg'}`,
			);
		try {
			localStorage.setItem('blog-theme', next);
		} catch (e) {
			/* 隐私模式下忽略存储失败 */
		}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: color-mix(in srgb, var(--paper) 88%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 72px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}

	.brand-mark {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px var(--accent-soft);
	}

	.brand-name {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.nav :global(a) {
		white-space: nowrap;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--accent);
		text-decoration: none;
		transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
	}

	.icon-link svg {
		width: 16px;
		height: 16px;
	}

	.icon-link:hover {
		color: var(--accent-strong);
		border-color: var(--accent);
		background: var(--accent-soft);
	}

	@media (max-width: 720px) {
		.header-inner {
			min-height: 62px;
			gap: 0.75rem;
		}
		.brand-name {
			font-size: 1.15rem;
		}
		.nav {
			gap: 1.1rem;
		}
		.icon-link {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.header-inner {
			min-height: 0;
			padding-block: 0.7rem 0;
			flex-wrap: wrap;
			row-gap: 0;
		}
		.nav {
			order: 3;
			width: 100%;
			justify-content: center;
			gap: 1.3rem;
			padding: 0.55rem 0 0.75rem;
			overflow-x: auto;
			scrollbar-width: none;
		}
		.nav::-webkit-scrollbar {
			display: none;
		}
	}

	@media (max-width: 400px) {
		.nav :global(a) {
			font-size: 0.8rem;
		}
		.brand-name {
			font-size: 1.05rem;
		}
		.brand-mark {
			display: none;
		}
	}
</style>
