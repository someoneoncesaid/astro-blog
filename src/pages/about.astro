---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { withBase } from '../utils/url';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} image="/blog-placeholder-about.jpg" />
	</head>
	<body>
		<Header />
		<main class="container about">
			<div class="about-head">
				<p class="eyebrow reveal">About · 关于我</p>
				<h1 class="reveal reveal--1">你好，我是<br /><em>这个博客的作者。</em></h1>
				<p class="about-lead reveal reveal--2">
					喜欢把复杂的事情讲清楚，也喜欢把一件小事慢慢写完整。这里是我留给自己的一块安静地方。
				</p>
			</div>

			<div class="about-grid">
				<figure class="about-photo reveal reveal--2">
					<img src={withBase('/blog-placeholder-about.jpg')} width={720} height={480} alt="一张暂用的书桌照片" />
					<figcaption>Fig. 01 — 一张暂用的照片</figcaption>
				</figure>

				<div class="about-body prose reveal reveal--3">
					<p>
						我是一名写代码的人，日常在界面、文档和各种细节之间来回折腾。工作之外，会读一点书，记一点笔记，偶尔把想明白的事情写成文章。
					</p>
					<p>
						开这个博客不是为了追热点，更多是想给那些「一时说不清、但值得再想想」的问题留个位置。写下来之后，思路往往会比在脑子里更清楚一些。
					</p>
					<p>
						如果你也在这里停了一会儿，希望这些文字对你有一点点用。欢迎通过页脚的链接找到我。
					</p>

					<dl class="about-facts">
						<div><dt>现在在做</dt><dd>前端与工具链</dd></div>
						<div><dt>常写的话题</dt><dd>代码 · 设计 · 日常</dd></div>
						<div><dt>更新频率</dt><dd>不定期，慢慢写</dd></div>
					</dl>
				</div>
			</div>

			<div class="about-quote">
				<p class="eyebrow">One more thing</p>
				<blockquote>「写得慢一点，才看得清楚一点。」</blockquote>
				<a class="btn" href={withBase('/blog')}>
					去看看文章
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about {
		padding-top: clamp(3rem, 7vw, 5.5rem);
	}

	.about-head {
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--line-strong);
	}

	.about-head h1 {
		margin: 1.1rem 0 1.4rem;
		font-size: clamp(2.4rem, 5.5vw, 4rem);
		line-height: 1.25;
		letter-spacing: -0.035em;
	}

	.about-head h1 em {
		color: var(--accent);
		font-style: normal;
	}

	.about-lead {
		max-width: 38rem;
		margin: 0;
		color: var(--ink-soft);
		font-size: 1.1rem;
		line-height: 1.9;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
		margin-top: 3.5rem;
	}

	.about-photo {
		margin: 0;
	}

	.about-photo img {
		width: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
	}

	.about-photo figcaption {
		margin-top: 0.7rem;
		color: var(--muted);
		font-family: var(--font-serif);
		font-size: 0.8rem;
		font-style: italic;
		letter-spacing: 0.04em;
	}

	.about-body {
		font-size: 1.02rem;
	}

	.about-facts {
		margin: 2.2rem 0 0;
		padding-top: 1.2rem;
		border-top: 1px solid var(--line);
	}

	.about-facts div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.55rem 0;
		border-bottom: 1px solid var(--line);
		font-size: 0.9rem;
	}

	.about-facts dt {
		color: var(--muted);
	}

	.about-facts dd {
		margin: 0;
		color: var(--ink);
	}

	.about-quote {
		margin-top: clamp(3.5rem, 7vw, 5.5rem);
		padding: clamp(2rem, 5vw, 3.5rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface-soft);
		text-align: center;
	}

	.about-quote blockquote {
		margin: 1rem 0 1.8rem;
		border: 0;
		padding: 0;
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: clamp(1.4rem, 3vw, 2rem);
		font-style: normal;
	}

	@media (max-width: 820px) {
		.about-grid {
			grid-template-columns: 1fr;
		}
		.about-photo {
			max-width: 28rem;
		}
	}
</style>
