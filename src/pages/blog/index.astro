---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
const categoryOf = (id: string) => (/markdown|mdx/i.test(id) ? '技术笔记' : '随笔');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章归档 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="archive">
			<section class="container archive-head reveal">
				<p class="eyebrow">Archive · 全部文章</p>
				<h1>写过的，都在这里。</h1>
				<div class="archive-sub">
					<p>{SITE_DESCRIPTION}</p>
					<span class="count">共 {posts.length} 篇</span>
				</div>
			</section>

			{
				featured && (
					<section class="container">
						<a class="featured" href={`/blog/${featured.id}/`}>
							<div class="featured-media">
								<img width={720} height={360} src={featured.data.heroImage} alt="" loading="eager" />
							</div>
							<div class="featured-content">
								<p class="eyebrow">编辑精选 · Featured</p>
								<h2>{featured.data.title}</h2>
								<p class="featured-desc">{featured.data.description}</p>
								<div class="featured-foot">
									<span class="meta">
										<FormattedDate date={featured.data.pubDate} />
										<span class="dot" />
										{categoryOf(featured.id)}
									</span>
									<span class="featured-cta">
										阅读文章
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
									</span>
								</div>
							</div>
						</a>
					</section>
				)
			}

			<section class="container grid-section">
				<div class="section-head">
					<div>
						<p class="eyebrow">More stories</p>
						<h2 class="section-title">继续翻阅</h2>
					</div>
				</div>

				<div class="card-grid">
					{
						rest.map((post) => (
							<article class="card reveal">
								<a href={`/blog/${post.id}/`}>
									<div class="card-media">
										<img width={720} height={360} src={post.data.heroImage} alt="" loading="lazy" />
									</div>
									<div class="card-body">
										<span class="card-tag">{categoryOf(post.id)}</span>
										<h3>{post.data.title}</h3>
										<div class="card-foot">
											<FormattedDate date={post.data.pubDate} />
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
										</div>
									</div>
								</a>
							</article>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.archive-head {
		padding: clamp(3rem, 7vw, 5.5rem) 0 2.5rem;
		border-bottom: 1px solid var(--line-strong);
	}

	.archive-head h1 {
		margin: 1rem 0 1.5rem;
		font-size: clamp(2.4rem, 5.5vw, 4rem);
	}

	.archive-sub {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.archive-sub p {
		margin: 0;
		color: var(--ink-soft);
	}

	.count {
		flex-shrink: 0;
		padding: 0.3rem 0.85rem;
		border: 1px solid var(--line-strong);
		border-radius: 100px;
		color: var(--muted);
		font-size: 0.78rem;
		letter-spacing: 0.05em;
	}

	.featured {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 0;
		margin-top: 3rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		color: inherit;
		text-decoration: none;
		overflow: hidden;
		transition: box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.featured:hover {
		border-color: var(--line-strong);
		box-shadow: var(--shadow-md);
		text-decoration: none;
	}

	.featured-media {
		overflow: hidden;
	}

	.featured-media img {
		width: 100%;
		height: 100%;
		min-height: 300px;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.5s var(--ease);
	}

	.featured:hover .featured-media img {
		transform: scale(1.035);
	}

	.featured-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(1.8rem, 4vw, 3rem);
	}

	.featured-content h2 {
		margin: 1rem 0 0.8rem;
		font-size: clamp(1.7rem, 3vw, 2.3rem);
		line-height: 1.25;
	}

	.featured-desc {
		margin: 0 0 2rem;
		color: var(--ink-soft);
		font-size: 0.98rem;
		line-height: 1.85;
	}

	.featured-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		margin-top: auto;
		padding-top: 1.2rem;
		border-top: 1px solid var(--line);
	}

	.featured-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--accent);
		font-size: 0.88rem;
	}

	.featured-cta svg {
		width: 16px;
		height: 16px;
		transition: transform 0.25s var(--ease);
	}

	.featured:hover .featured-cta svg {
		transform: translateX(4px);
	}

	.grid-section {
		margin-top: clamp(3.5rem, 7vw, 5.5rem);
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2.5rem 2rem;
	}

	.card a {
		display: block;
		height: 100%;
		padding: 0 0 1.2rem;
		border-bottom: 1px solid var(--line-strong);
		color: inherit;
		text-decoration: none;
	}

	.card-media {
		margin-bottom: 1.2rem;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--surface-soft);
	}

	.card-media img {
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.5s var(--ease), opacity 0.3s ease;
	}

	.card a:hover .card-media img {
		transform: scale(1.035);
		opacity: 0.9;
	}

	.card-tag {
		display: inline-block;
		margin-bottom: 0.6rem;
		padding: 0.18rem 0.6rem;
		border: 1px solid var(--accent);
		border-radius: 2px;
		color: var(--accent);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
	}

	.card h3 {
		margin: 0 0 1rem;
		font-size: 1.45rem;
		line-height: 1.32;
		transition: color 0.2s ease;
	}

	.card a:hover h3 {
		color: var(--accent);
	}

	.card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--muted);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
	}

	.card-foot svg {
		width: 18px;
		height: 18px;
		color: var(--line-strong);
		transition: color 0.2s ease, transform 0.25s var(--ease);
	}

	.card a:hover .card-foot svg {
		color: var(--accent);
		transform: translateX(4px);
	}

	@media (max-width: 820px) {
		.featured {
			grid-template-columns: 1fr;
		}
		.featured-media img {
			min-height: 0;
			aspect-ratio: 2 / 1;
		}
	}

	@media (max-width: 620px) {
		.archive-sub {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.8rem;
		}
		.card-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
