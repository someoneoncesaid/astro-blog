---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { withBase } from '../../utils/url';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
const categoryOf = (post: (typeof posts)[number]) => post.data.category || '未分类';
const searchTextOf = (post: (typeof posts)[number]) =>
	[post.data.title, post.data.description, categoryOf(post), ...post.data.tags].join(' ');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章归档 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="archive">
			<section class="container archive-head reveal">
				<p class="eyebrow">Archive · 全部文章</p>
				<h1>写过的，都在这里。</h1>
				<div class="archive-sub">
					<p>{SITE_DESCRIPTION}</p>
					<span class="count">共 {posts.length} 篇</span>
				</div>
			</section>

			<div class="container search-status-wrap">
				<p class="search-status" id="search-status" hidden>
					<span id="search-status-text"></span>
					<a href={withBase('/blog/')}>清除搜索</a>
				</p>
			</div>

			{
				featured && (
					<section class="container" data-search={searchTextOf(featured)}>
						<a class="featured" href={withBase(`/blog/${featured.id}/`)}>
							<div class="featured-media">
								{
									featured.data.heroImage ? (
										<img width={720} height={360} src={withBase(featured.data.heroImage)} alt="" loading="eager" />
									) : (
										<div class="cover-fallback" aria-hidden="true">
											<span class="cover-fallback-mark">{featured.data.title.trim().charAt(0)}</span>
											<span class="cover-fallback-kicker">{categoryOf(featured)}</span>
											<span class="cover-fallback-title">{featured.data.title}</span>
										</div>
									)
								}
							</div>
							<div class="featured-content">
								<p class="eyebrow">编辑精选 · Featured</p>
								<h2>{featured.data.title}</h2>
								<p class="featured-desc">{featured.data.description}</p>
								<div class="featured-foot">
									<span class="meta">
										<FormattedDate date={featured.data.pubDate} />
										<span class="dot" />
										{categoryOf(featured)}
									</span>
									<span class="featured-cta">
										阅读文章
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
									</span>
								</div>
							</div>
						</a>
					</section>
				)
			}

			<section class="container grid-section" id="more-posts">
				<div class="section-head">
					<div>
						<p class="eyebrow">More stories</p>
						<h2 class="section-title">继续翻阅</h2>
					</div>
				</div>

				<div class="card-grid">
					{
						rest.map((post) => (
							<article class="card reveal" data-search={searchTextOf(post)}>
								<a href={withBase(`/blog/${post.id}/`)}>
									<div class="card-media">
										{
											post.data.heroImage ? (
												<img width={720} height={360} src={withBase(post.data.heroImage)} alt="" loading="lazy" />
											) : (
												<div class="cover-fallback" aria-hidden="true">
													<span class="cover-fallback-mark">{post.data.title.trim().charAt(0)}</span>
													<span class="cover-fallback-kicker">{categoryOf(post)}</span>
													<span class="cover-fallback-title">{post.data.title}</span>
												</div>
											)
										}
									</div>
									<div class="card-body">
										<span class="card-tag">{categoryOf(post)}</span>
										<h3>{post.data.title}</h3>
										<div class="card-foot">
											<FormattedDate date={post.data.pubDate} />
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
										</div>
									</div>
								</a>
							</article>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
		<script>
			const params = new URLSearchParams(window.location.search);
			const query = params.get('q')?.trim();

			if (query) {
				const needle = query.toLocaleLowerCase();
				const items = Array.from(document.querySelectorAll<HTMLElement>('[data-search]'));
				let matches = 0;

				for (const item of items) {
					const haystack = (item.dataset.search ?? '').toLocaleLowerCase();
					const hit = haystack.includes(needle);
					item.classList.toggle('is-search-hidden', !hit);
					if (hit) matches += 1;
				}

				const gridSection = document.getElementById('more-posts');
				if (gridSection && !gridSection.querySelector('[data-search]:not(.is-search-hidden)')) {
					gridSection.hidden = true;
				}

				const status = document.getElementById('search-status');
				const statusText = document.getElementById('search-status-text');
				if (status && statusText) {
					statusText.textContent = `搜索「${query}」：${matches} 篇结果`;
					status.hidden = false;
				}
			}
		</script>
	</body>
</html>

<style>
	.search-status-wrap {
		margin-top: 1.5rem;
	}

	.search-status {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0;
		padding: 0.85rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--ink-soft);
		font-size: 0.82rem;
	}

	.search-status[hidden] {
		display: none;
	}

	.search-status a {
		margin-left: auto;
		color: var(--accent);
		font-size: 0.78rem;
		text-decoration: none;
	}

	.search-status a:hover {
		color: var(--accent-strong);
	}

	.is-search-hidden {
		display: none !important;
	}

	.archive-head {
		padding: clamp(3rem, 7vw, 5.5rem) 0 2.5rem;
		border-bottom: 1px solid var(--line-strong);
	}

	.archive-head h1 {
		margin: 1rem 0 1.5rem;
		font-size: clamp(2.4rem, 5.5vw, 4rem);
	}

	.archive-sub {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.archive-sub p {
		margin: 0;
		color: var(--ink-soft);
	}

	.count {
		flex-shrink: 0;
		padding: 0.3rem 0.85rem;
		border: 1px solid var(--line-strong);
		border-radius: 100px;
		color: var(--muted);
		font-size: 0.78rem;
		letter-spacing: 0.05em;
	}

	.featured {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 0;
		margin-top: 3rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		color: inherit;
		text-decoration: none;
		overflow: hidden;
		transition: box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.featured:hover {
		border-color: var(--line-strong);
		box-shadow: var(--shadow-md);
		text-decoration: none;
	}

	.featured-media {
		overflow: hidden;
	}

	.featured-media img {
		width: 100%;
		height: 100%;
		min-height: 300px;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.5s var(--ease);
	}

	.featured:hover .featured-media img {
		transform: scale(1.035);
	}

	/* 没有 heroImage 的文章（同步自母稿）使用排版封面 */
	.cover-fallback {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.5rem;
		width: 100%;
		height: 100%;
		min-height: 300px;
		padding: clamp(1.3rem, 3vw, 2.2rem);
		border-left: 2px solid var(--accent);
		background:
			linear-gradient(135deg, var(--accent-soft) 0%, transparent 62%),
			var(--surface-soft);
		overflow: hidden;
	}

	.cover-fallback-mark {
		position: absolute;
		right: 0.02em;
		bottom: -0.22em;
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: clamp(7rem, 13vw, 11rem);
		line-height: 1;
		opacity: 0.1;
		pointer-events: none;
		user-select: none;
		transition: transform 0.5s var(--ease);
	}

	.featured:hover .cover-fallback-mark {
		transform: translateY(-6px);
	}

	.cover-fallback-kicker {
		position: relative;
		color: var(--accent);
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.cover-fallback-title {
		position: relative;
		display: -webkit-box;
		overflow: hidden;
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.2vw, 1.9rem);
		line-height: 1.32;
		letter-spacing: -0.01em;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.featured-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(1.8rem, 4vw, 3rem);
	}

	.featured-content h2 {
		margin: 1rem 0 0.8rem;
		font-size: clamp(1.7rem, 3vw, 2.3rem);
		line-height: 1.25;
	}

	.featured-desc {
		margin: 0 0 2rem;
		color: var(--ink-soft);
		font-size: 0.98rem;
		line-height: 1.85;
	}

	.featured-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		margin-top: auto;
		padding-top: 1.2rem;
		border-top: 1px solid var(--line);
	}

	.featured-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--accent);
		font-size: 0.88rem;
	}

	.featured-cta svg {
		width: 16px;
		height: 16px;
		transition: transform 0.25s var(--ease);
	}

	.featured:hover .featured-cta svg {
		transform: translateX(4px);
	}

	.grid-section {
		margin-top: clamp(3.5rem, 7vw, 5.5rem);
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2.5rem 2rem;
	}

	.card a {
		display: block;
		height: 100%;
		padding: 0 0 1.2rem;
		border-bottom: 1px solid var(--line-strong);
		color: inherit;
		text-decoration: none;
	}

	.card-media {
		margin-bottom: 1.2rem;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--surface-soft);
	}

	.card-media img {
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.5s var(--ease), opacity 0.3s ease;
	}

	.card a:hover .card-media img {
		transform: scale(1.035);
		opacity: 0.9;
	}

	.card-media .cover-fallback {
		min-height: 0;
		aspect-ratio: 2 / 1;
		padding: clamp(1.1rem, 2vw, 1.6rem);
	}

	.card-media .cover-fallback-mark {
		font-size: clamp(5rem, 8vw, 7rem);
	}

	.card-media .cover-fallback-title {
		font-size: clamp(1.05rem, 1.6vw, 1.35rem);
		-webkit-line-clamp: 2;
	}

	.card a:hover .cover-fallback-mark {
		transform: translateY(-4px);
	}

	.card-tag {
		display: inline-block;
		margin-bottom: 0.6rem;
		padding: 0.18rem 0.6rem;
		border: 1px solid var(--accent);
		border-radius: 2px;
		color: var(--accent);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
	}

	.card h3 {
		margin: 0 0 1rem;
		font-size: 1.45rem;
		line-height: 1.32;
		transition: color 0.2s ease;
	}

	.card a:hover h3 {
		color: var(--accent);
	}

	.card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--muted);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
	}

	.card-foot svg {
		width: 18px;
		height: 18px;
		color: var(--line-strong);
		transition: color 0.2s ease, transform 0.25s var(--ease);
	}

	.card a:hover .card-foot svg {
		color: var(--accent);
		transform: translateX(4px);
	}

	@media (max-width: 820px) {
		.featured {
			grid-template-columns: 1fr;
		}
		.featured-media img {
			min-height: 0;
			aspect-ratio: 2 / 1;
		}
	}

	@media (max-width: 620px) {
		.archive-sub {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.8rem;
		}
		.card-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
