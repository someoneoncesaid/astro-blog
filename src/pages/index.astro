---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const categoryOf = (post: (typeof posts)[number]) => post.data.category || '未分类';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_TITLE} · 首页`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero container">
				<div class="hero-main">
					<p class="eyebrow reveal">个人博客 · 写作与记录</p>
					<h1 class="hero-title reveal reveal--1">
						把想法写下来，<br />
						<em>慢慢整理成文章。</em>
					</h1>
					<p class="hero-desc reveal reveal--2">
						{SITE_DESCRIPTION} 这里没有时间线，只有一篇篇写完之后还愿意再读一遍的文字。
					</p>
					<div class="hero-actions reveal reveal--3">
						<a class="btn btn--primary" href="/blog">
							开始阅读
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</a>
						<a class="btn" href="/about">关于我</a>
					</div>
					<div class="hero-foot reveal reveal--4">
						<span class="hero-foot-rule"></span>
						<span>不定期更新 · 保持好奇 · 慢慢写</span>
					</div>
				</div>

				<aside class="hero-aside" aria-hidden="true">
					<div class="aside-top"><span>VOL. 01</span><span>EST. 2022</span></div>
					<div class="stamp">
						<span>INK</span>
						<span class="stamp-amp">&amp;</span>
						<span>PAPER</span>
					</div>
					<p class="aside-vertical">NOTES ON CODE, DESIGN &amp; EVERYDAY LIFE</p>
				</aside>
			</section>

			<section class="container section">
				<div class="section-head">
					<div>
						<p class="eyebrow">Latest writing · 最近在写</p>
						<h2 class="section-title">文章选读</h2>
					</div>
					<a class="text-link" href="/blog">
						全部文章
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</a>
				</div>

				<ul class="post-list">
					{
						posts.map((post, i) => (
							<li class="post-row">
								<a href={`/blog/${post.id}/`}>
									<span class="post-index">{String(i + 1).padStart(2, '0')}</span>
									<span class="post-body">
										<span class="post-meta">
											<FormattedDate date={post.data.pubDate} />
											<span class="dot" />
											{categoryOf(post)}
										</span>
										<span class="post-title">{post.data.title}</span>
									</span>
									<span class="post-arrow">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="container section">
				<div class="note-band">
					<div class="note-band-main">
						<p class="eyebrow">About this space</p>
						<h2>一间安静的书房，<br />留给长一点的思考。</h2>
					</div>
					<div class="note-band-side">
						<p>
							写东西是一种整理：把散落的念头收拢，再按顺序放回去。这里收录关于代码、设计与日常的笔记，不追热点，也不赶进度。
						</p>
						<a class="btn" href="/about">
							认识一下
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 220px;
		gap: 4rem;
		padding: clamp(3.5rem, 8vw, 6.5rem) 0 3.5rem;
		border-bottom: 1px solid var(--line-strong);
	}

	.hero-title {
		margin: 1.4rem 0 1.5rem;
		font-size: clamp(2.6rem, 6.2vw, 4.6rem);
		line-height: 1.22;
		letter-spacing: -0.035em;
	}

	.hero-title em {
		color: var(--accent);
		font-style: normal;
	}

	.hero-desc {
		max-width: 34rem;
		margin: 0;
		color: var(--ink-soft);
		font-size: 1.08rem;
		line-height: 1.9;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2.2rem;
	}

	.hero-foot {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin-top: 3.5rem;
		color: var(--muted);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
	}

	.hero-foot-rule {
		width: 42px;
		height: 1px;
		background: var(--accent);
	}

	.hero-aside {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		justify-content: space-between;
		padding-top: 0.5rem;
		border-left: 1px solid var(--line);
	}

	.aside-top {
		display: flex;
		gap: 1.2rem;
		color: var(--muted);
		font-size: 0.68rem;
		letter-spacing: 0.18em;
	}

	.stamp {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 132px;
		height: 132px;
		margin: 1.5rem -1rem 1.5rem 0;
		border: 1px solid var(--accent);
		border-radius: 50%;
		box-shadow: inset 0 0 0 4px var(--paper), inset 0 0 0 5px var(--accent);
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: 0.95rem;
		letter-spacing: 0.16em;
		line-height: 1.25;
		transform: rotate(-11deg);
	}

	.stamp-amp {
		font-size: 1.5rem;
		font-style: italic;
	}

	.aside-vertical {
		margin: 0 0 0.5rem;
		color: var(--muted);
		font-size: 0.68rem;
		letter-spacing: 0.22em;
		writing-mode: vertical-rl;
	}

	.section {
		margin-top: clamp(3.5rem, 7vw, 5.5rem);
	}

	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-row {
		border-bottom: 1px solid var(--line);
	}

	.post-row:first-child {
		border-top: 1px solid var(--line);
	}

	.post-row a {
		display: grid;
		grid-template-columns: 3.2rem minmax(0, 1fr) 2rem;
		align-items: center;
		gap: 1.2rem;
		padding: 1.5rem 1.1rem;
		color: inherit;
		text-decoration: none;
		transition: background 0.22s ease;
	}

	.post-row a:hover {
		background: var(--surface);
	}

	.post-index {
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: 1.15rem;
		letter-spacing: 0.04em;
	}

	.post-body {
		min-width: 0;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 0.35rem;
		color: var(--muted);
		font-size: 0.78rem;
		letter-spacing: 0.05em;
	}

	.post-meta .dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--line-strong);
	}

	.post-title {
		display: block;
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: clamp(1.3rem, 2.4vw, 1.75rem);
		line-height: 1.3;
		transition: color 0.2s ease;
	}

	.post-row a:hover .post-title {
		color: var(--accent);
	}

	.post-arrow {
		display: flex;
		justify-content: flex-end;
		color: var(--line-strong);
		transition: color 0.2s ease, transform 0.25s var(--ease);
	}

	.post-arrow svg {
		width: 22px;
		height: 22px;
	}

	.post-row a:hover .post-arrow {
		color: var(--accent);
		transform: translateX(4px);
	}

	.note-band {
		position: relative;
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 3rem;
		padding: clamp(2rem, 5vw, 3.5rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface-soft);
		overflow: hidden;
	}

	.note-band::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 72px;
		height: 3px;
		background: var(--accent);
	}

	.note-band h2 {
		margin: 0.8rem 0 0;
		font-size: clamp(1.5rem, 3vw, 2.1rem);
		line-height: 1.4;
	}

	.note-band-side {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 1.4rem;
	}

	.note-band-side p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.98rem;
		line-height: 1.9;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
		}
		.hero-aside {
			display: none;
		}
	}

	@media (max-width: 720px) {
		.hero {
			padding-top: 3rem;
			padding-bottom: 2.5rem;
		}
		.hero-foot {
			margin-top: 2.5rem;
		}
		.post-row a {
			grid-template-columns: 2.2rem minmax(0, 1fr) 1.4rem;
			gap: 0.8rem;
			padding: 1.2rem 0.4rem;
		}
		.note-band {
			grid-template-columns: 1fr;
			gap: 1.6rem;
		}
	}
</style>
