---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { withBase } from '../utils/url';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 4);
const postTitles = new Set(posts.map((post) => post.data.title.trim()));

// 展板上同时放文章和图文；跳过与任意文章完全同名的图文，避免重复卡片
const eligibleSummaries = (await getCollection('summaries'))
	.filter(
		(entry) =>
			!entry.data.draft &&
			entry.data.cards.length > 0 &&
			!postTitles.has(entry.data.title.trim()),
	)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const summaries = eligibleSummaries.slice(0, 2);

const categoryOf = (data: { category?: string }) => data.category || '未分类';
const dateLabelOf = (date: Date) =>
	date.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' });

type BoardCard = {
	slot: string;
	href: string;
	title: string;
	date: Date;
	category: string;
	type: 'article' | 'visual';
	typeLabel: string;
	featured?: boolean;
};

const postCards: BoardCard[] = latestPosts.map((post) => ({
	slot: '',
	href: `/blog/${post.id}/`,
	title: post.data.title,
	date: post.data.pubDate,
	category: categoryOf(post.data),
	type: 'article',
	typeLabel: '文章',
}));

const summaryCards: BoardCard[] = summaries.map((entry) => ({
	slot: '',
	href: `/summaries/${entry.id}/`,
	title: entry.data.title,
	date: entry.data.pubDate,
	category: categoryOf(entry.data),
	type: 'visual',
	typeLabel: '图文',
}));

const boardSlots = [
	{ card: postCards[0], slot: 'a', featured: true },
	{ card: summaryCards[0], slot: 'b' },
	{ card: postCards[1], slot: 'c' },
	{ card: postCards[2], slot: 'd' },
	{ card: summaryCards[1], slot: 'e' },
	{ card: postCards[3], slot: 'f' },
];

const boardCards = boardSlots
	.filter((item): item is { card: BoardCard; slot: string; featured?: boolean } => Boolean(item.card))
	.map((item) => ({ ...item.card, slot: item.slot, featured: item.featured }));

type MoreCard = {
	href: string;
	title: string;
	dateLabel: string;
	isoDate: string;
	category: string;
	type: 'article' | 'visual';
	typeLabel: string;
};

const morePosts: MoreCard[] = posts.slice(4).map((post) => ({
	href: withBase(`/blog/${post.id}/`),
	title: post.data.title,
	dateLabel: dateLabelOf(post.data.pubDate),
	isoDate: post.data.pubDate.toISOString(),
	category: categoryOf(post.data),
	type: 'article',
	typeLabel: '文章',
}));

const moreSummaries: MoreCard[] = eligibleSummaries.slice(2).map((entry) => ({
	href: withBase(`/summaries/${entry.id}/`),
	title: entry.data.title,
	dateLabel: dateLabelOf(entry.data.pubDate),
	isoDate: entry.data.pubDate.toISOString(),
	category: categoryOf(entry.data),
	type: 'visual',
	typeLabel: '图文',
}));

// 按文章 / 图文交替排队，画布滚动时一批批取用
const moreCards: MoreCard[] = [];
for (let i = 0; i < Math.max(morePosts.length, moreSummaries.length); i += 1) {
	if (morePosts[i]) moreCards.push(morePosts[i]);
	if (moreSummaries[i]) moreCards.push(moreSummaries[i]);
}
const moreCardsJson = JSON.stringify(moreCards).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_TITLE} · 首页`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="container hero-board">
				<div class="board reveal">
					<a class="board-open" href={withBase('/blog/')} aria-label="打开全部文章" title="打开全部文章">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
							<path d="M15 3h6v6M21 3 10 14M9 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>

					<div class="board-zoom" data-canvas-control role="group" aria-label="画布缩放">
						<button type="button" data-zoom-out aria-label="缩小">−</button>
						<button type="button" data-zoom-reset aria-label="重置画布" title="重置画布"><span data-zoom-label>100%</span></button>
						<button type="button" data-zoom-in aria-label="放大">+</button>
					</div>

					<div class="board-load-status" aria-live="polite">
						<span class="board-load-dot" aria-hidden="true"></span>
						正在加载更多
					</div>

					<div class="board-world">
						<div class="board-center">
						<p class="eyebrow board-eyebrow reveal">SomeoneOnceSaid · 文章与笔记</p>
						<h1 class="board-title reveal reveal--1">
							Someone Once Said<span class="board-title-dot">.</span>
						</h1>
						<p class="board-desc reveal reveal--2">
							有些话读过就忘了，有些话会在写代码、做设计，或者过日子的时候又想起来。后面这些，我想记下来。
						</p>
						<form class="board-search reveal reveal--3" action={withBase('/blog/')} method="get" role="search">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<circle cx="11" cy="11" r="7" />
								<path d="m16.6 16.6 3.9 3.9" stroke-linecap="round" />
							</svg>
							<label class="sr-only" for="board-search">搜索文章</label>
							<input id="board-search" type="search" name="q" placeholder="搜索文章标题、分类或标签…" autocomplete="off" />
							<kbd aria-hidden="true">/</kbd>
							<button class="sr-only" type="submit">搜索</button>
						</form>
						<p class="board-canvas-hint">拖动或滚动平移 · ⌘ / Ctrl + 滚轮缩放</p>
					</div>

					<div class="board-cards">
						{
							boardCards.map((card, index) => (
								<a
									class:list={[
										'board-card',
										`board-card--${card.slot}`,
										{ 'board-card--feature': card.featured },
									]}
									href={withBase(card.href)}
									style={`--card-delay: ${index * 70}ms`}
								>
									{card.featured && (
										<div class="board-card-art" aria-hidden="true">
											<svg viewBox="0 0 120 100" fill="none">
												<path d="M60 20C48 12 30 11 16 16v62c14-5 32-4 44 4V20Z" fill="var(--accent-soft)" stroke="var(--ink)" stroke-width="2.2" stroke-linejoin="round" />
												<path d="M60 20c12-8 30-9 44-4v62c-14-5-32-4-44 4V20Z" fill="var(--art-blush)" stroke="var(--ink)" stroke-width="2.2" stroke-linejoin="round" />
												<path d="M60 20v62" stroke="var(--ink)" stroke-width="2.2" />
												<path d="M28 32c8-2 16-2 22 1M28 44c8-2 16-2 22 1M28 56c8-2 16-2 22 1M70 33c8-3 16-3 22-1M70 45c8-3 16-3 22-1M70 57c8-3 16-3 22-1" stroke="var(--ink)" stroke-opacity=".5" stroke-width="1.6" stroke-linecap="round" />
												<path d="M38 78c6-5 12-5 18 0M64 78c6-5 12-5 18 0" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
											</svg>
										</div>
									)}

									<div class="board-card-main">
										<div class="board-card-head">
											<span class="board-card-kind">
												{card.type === 'visual' ? (
													<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
														<rect x="4" y="4" width="16" height="16" rx="2" />
														<circle cx="9" cy="9" r="1.4" />
														<path d="m4 17 5-5 4 4 3-3 4 4" stroke-linecap="round" stroke-linejoin="round" />
													</svg>
												) : (
													<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
														<path d="M7 3h7l4 4v14H7z" stroke-linejoin="round" />
														<path d="M14 3v4h4M10 12h6M10 16h6" stroke-linecap="round" stroke-linejoin="round" />
													</svg>
												)}
												{card.typeLabel}
											</span>
											<span class="board-card-date"><FormattedDate date={card.date} /></span>
										</div>
										<span class="board-card-title">{card.title}</span>
										<span class="board-card-foot">
											{card.category}
											<span class="board-card-arrow" aria-hidden="true">→</span>
										</span>
									</div>
								</a>
							))
						}

						<div class="board-card board-card--social" aria-labelledby="board-social-title">
							<div class="board-card-head">
								<span class="board-card-kind">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
										<circle cx="6" cy="12" r="2.4" />
										<circle cx="18" cy="6" r="2.4" />
										<circle cx="18" cy="18" r="2.4" />
										<path d="m8.2 10.8 7.6-3.6M8.2 13.2l7.6 3.6" stroke-linecap="round" />
									</svg>
									社交
								</span>
								<span class="board-card-date">Elsewhere</span>
							</div>
							<p class="board-social-title" id="board-social-title">在这些地方找到我</p>
							<p class="board-social-note">文章之外，也会发图卡和短笔记。</p>
							<div class="board-social-links">
								<SocialLinks compact />
							</div>
						</div>

						<div class="board-art" aria-hidden="true">
							<svg viewBox="0 0 120 100" fill="none">
								<path d="M60 82S20 58 20 34c0-14 17-21 27-10l13 13 13-13c10-11 27-4 27 10 0 24-40 48-40 48Z" fill="var(--art-blush)" stroke="var(--ink)" stroke-width="2.2" stroke-linejoin="round" />
								<path d="M38 58c5-4 9-3 12 1 3 4 7 5 12 1 5-4 10-4 15 0" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
								<path d="M46 68c8-4 16-3 24 1" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" stroke-opacity=".5" />
							</svg>
						</div>
					</div>
					</div>
				</div>
			</section>

			<template id="board-more-template">
				<a class="board-card board-card--more" href="#" draggable="false">
					<div class="board-card-main">
						<div class="board-card-head">
							<span class="board-card-kind">
								<svg data-icon="visual" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
									<rect x="4" y="4" width="16" height="16" rx="2" />
									<circle cx="9" cy="9" r="1.4" />
									<path d="m4 17 5-5 4 4 3-3 4 4" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								<svg data-icon="article" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
									<path d="M7 3h7l4 4v14H7z" stroke-linejoin="round" />
									<path d="M14 3v4h4M10 12h6M10 16h6" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								<span data-card-type></span>
							</span>
							<span class="board-card-date"><time data-card-date></time></span>
						</div>
						<span class="board-card-title" data-card-title></span>
						<span class="board-card-foot">
							<span data-card-category></span>
							<span class="board-card-arrow" aria-hidden="true">→</span>
						</span>
					</div>
				</a>
			</template>

			<template id="board-skeleton-template">
				<div class="board-card board-card--more board-card--skeleton" aria-hidden="true">
					<div class="board-card-main">
						<div class="board-card-head"><span class="sk-line sk-line--xs"></span><span class="sk-line sk-line--xxs"></span></div>
						<span class="sk-line sk-line--lg"></span>
						<span class="sk-line sk-line--md"></span>
						<div class="sk-foot"><span class="sk-line sk-line--xs"></span><span class="sk-line sk-line--xxs"></span></div>
					</div>
				</div>
			</template>

			<template id="board-end-template">
				<div class="board-card board-card--end">
					<div class="board-card-head">
						<span class="board-card-kind">画布尽头</span>
						<span class="board-card-date">Fin.</span>
					</div>
					<p class="board-end-title">已经翻到这里了</p>
					<p class="board-end-note">画布之外的文字，都在文章归档里。</p>
					<a class="board-end-link" href={withBase('/blog/')}>去归档看看 <span aria-hidden="true">→</span></a>
				</div>
			</template>

			<script is:inline type="application/json" id="board-more-data" set:html={moreCardsJson}></script>

			<section class="container section">
				<div class="section-head">
					<div>
						<p class="eyebrow">Latest writing · 最近在写</p>
						<h2 class="section-title">文章选读</h2>
					</div>
					<a class="text-link" href={withBase('/blog/')}>
						全部文章
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</a>
				</div>

				<ul class="post-list">
					{
						latestPosts.map((post, i) => (
							<li class="post-row">
								<a href={withBase(`/blog/${post.id}/`)}>
									<span class="post-index">{String(i + 1).padStart(2, '0')}</span>
									<span class="post-body">
										<span class="post-meta">
											<FormattedDate date={post.data.pubDate} />
											<span class="dot" />
											{categoryOf(post.data)}
										</span>
										<span class="post-title">{post.data.title}</span>
									</span>
									<span class="post-arrow">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="container section">
				<div class="note-band">
					<div class="note-band-main">
						<p class="eyebrow">About this space</p>
						<h2>一间安静的书房，<br />留给长一点的思考。</h2>
					</div>
					<div class="note-band-side">
						<p>
							写东西是一种整理：把散落的念头收拢，再按顺序放回去。这里收录关于代码、设计与日常的笔记，不追热点，也不赶进度。
						</p>
						<a class="btn" href={withBase('/about')}>
							认识一下
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
		<script>
			const boardSearch = document.getElementById('board-search') as HTMLInputElement | null;
			document.addEventListener('keydown', (event) => {
				const target = event.target as HTMLElement | null;
				const isTyping = target?.closest('input, textarea, select, [contenteditable="true"]');
				if (event.key === '/' && !isTyping && !event.metaKey && !event.ctrlKey && !event.altKey) {
					event.preventDefault();
					boardSearch?.focus();
					boardSearch?.select();
				}
			});

			const board = document.querySelector<HTMLElement>('.board');
			const world = board?.querySelector<HTMLElement>('.board-world');
			const zoomLabel = board?.querySelector<HTMLElement>('[data-zoom-label]');

			if (board && world && zoomLabel) {
				const MIN_SCALE = 0.55;
				const MAX_SCALE = 1.7;
				const GRID_SIZE = 84;
				const canvasMedia = window.matchMedia('(min-width: 1025px)');

				let canvasEnabled = false;
				let scale = 1;
				let offsetX = 0;
				let offsetY = 0;
				let activePointer: number | null = null;
				let startX = 0;
				let startY = 0;
				let startOffsetX = 0;
				let startOffsetY = 0;
				let moved = false;
				let suppressClick = false;

				const applyView = () => {
					world.style.transform = `translate3d(${offsetX}px, ${offsetY}px, 0) scale(${scale})`;
					board.style.backgroundSize = `${GRID_SIZE * scale}px ${GRID_SIZE * scale}px`;
					board.style.backgroundPosition = `${offsetX}px ${offsetY}px`;
					zoomLabel.textContent = `${Math.round(scale * 100)}%`;
				};

				/* ---------- 画布滚动加载 ---------- */

				type BoardMoreCard = {
					href: string;
					title: string;
					dateLabel: string;
					isoDate: string;
					category: string;
					type: 'article' | 'visual';
					typeLabel: string;
				};

				type Box = { x: number; y: number; w: number; h: number };
				type Point = { x: number; y: number };

				const cardLayer = world.querySelector<HTMLElement>('.board-cards');
				const moreDataEl = document.getElementById('board-more-data');
				const moreTemplate = document.getElementById('board-more-template') as HTMLTemplateElement | null;
				const skeletonTemplate = document.getElementById('board-skeleton-template') as HTMLTemplateElement | null;
				const endTemplate = document.getElementById('board-end-template') as HTMLTemplateElement | null;

				let moreQueue: BoardMoreCard[] = [];
				try {
					moreQueue = JSON.parse(moreDataEl?.textContent || '[]') as BoardMoreCard[];
				} catch {
					moreQueue = [];
				}

				const MORE_WIDTH = 280;
				const END_WIDTH = 300;
				const CARD_HEIGHT = 190;
				const CARD_GAP = 16;

				let queueCursor = 0;
				let nextRing = 1;
				let batchInFlight = false;
				let endPlaced = false;
				let checkTimer = 0;
				let batchTimer = 0;
				let endTimer = 0;
				let lastBatchAt = 0;

				const viewRect = () => ({
					x0: -offsetX / scale,
					y0: -offsetY / scale,
					x1: (board.clientWidth - offsetX) / scale,
					y1: (board.clientHeight - offsetY) / scale,
				});

				const shouldLoadNextRing = () => {
					const view = viewRect();
					const loaded = { x0: 0, y0: 0, x1: board.clientWidth, y1: board.clientHeight };
					cardLayer?.querySelectorAll<HTMLElement>('.board-card--more').forEach((card) => {
						loaded.x0 = Math.min(loaded.x0, card.offsetLeft);
						loaded.y0 = Math.min(loaded.y0, card.offsetTop);
						loaded.x1 = Math.max(loaded.x1, card.offsetLeft + card.offsetWidth);
						loaded.y1 = Math.max(loaded.y1, card.offsetTop + card.offsetHeight);
					});
					const overlapWidth = Math.max(0, Math.min(view.x1, loaded.x1) - Math.max(view.x0, loaded.x0));
					const overlapHeight = Math.max(0, Math.min(view.y1, loaded.y1) - Math.max(view.y0, loaded.y0));
					const viewArea = (view.x1 - view.x0) * (view.y1 - view.y0);
					return overlapWidth * overlapHeight <= viewArea / 2;
				};

				const obstacles = (): Box[] => {
					const boxes: Box[] = [];
					board.querySelectorAll<HTMLElement>('.board-cards .board-card, .board-cards .board-art').forEach((element) => {
						boxes.push({
							x: element.offsetLeft,
							y: element.offsetTop,
							w: element.offsetWidth,
							h: element.offsetHeight,
						});
					});
					const center = board.querySelector<HTMLElement>('.board-center');
					if (center) {
						boxes.push({
							x: center.offsetLeft - center.offsetWidth / 2,
							y: center.offsetTop - center.offsetHeight / 2,
							w: center.offsetWidth,
							h: center.offsetHeight,
						});
					}
					return boxes;
				};

				const findRingPositions = (count: number, width: number, height: number): Point[] => {
					const center = board.querySelector<HTMLElement>('.board-center');
					const centerX = center?.offsetLeft ?? board.clientWidth / 2;
					const centerY = center?.offsetTop ?? board.clientHeight / 2;
					const boxes = obstacles();
					const positions: Point[] = [];

					while (!positions.length) {
						const ring = nextRing++;
						for (let row = -ring; row <= ring; row += 1) {
							for (let col = -ring; col <= ring; col += 1) {
								if (Math.max(Math.abs(row), Math.abs(col)) !== ring) continue;
								const x = centerX + col * (MORE_WIDTH + CARD_GAP) - width / 2;
								const y = centerY + row * (CARD_HEIGHT + CARD_GAP) - height / 2;
								const blocked = boxes.some(
									(box) =>
										x < box.x + box.w + CARD_GAP &&
										x + width + CARD_GAP > box.x &&
										y < box.y + box.h + CARD_GAP &&
										y + height + CARD_GAP > box.y,
								);
								if (!blocked) positions.push({ x, y });
							}
						}
					}

					if (positions.length <= count) return positions;
					return Array.from({ length: count }, (_, index) =>
						positions[Math.floor(((index + 0.5) * positions.length) / count)],
					);
				};

				const makeSkeleton = (position: Point) => {
					if (!skeletonTemplate) return null;
					const fragment = skeletonTemplate.content.cloneNode(true) as DocumentFragment;
					const skeleton = fragment.querySelector<HTMLElement>('.board-card--skeleton');
					if (!skeleton) return null;
					skeleton.style.left = `${position.x}px`;
					skeleton.style.top = `${position.y}px`;
					return skeleton;
				};

				const makeCard = (card: BoardMoreCard, position: Point) => {
					if (!moreTemplate) return null;
					const fragment = moreTemplate.content.cloneNode(true) as DocumentFragment;
					const link = fragment.querySelector<HTMLAnchorElement>('.board-card--more');
					if (!link || !cardLayer) return null;

					link.href = card.href;
					link.style.left = `${position.x}px`;
					link.style.top = `${position.y}px`;
					link.setAttribute('draggable', 'false');

					link.querySelectorAll<SVGElement>('svg[data-icon]').forEach((icon) => {
						icon.style.display = icon.dataset.icon === card.type ? 'block' : 'none';
					});

					const type = link.querySelector<HTMLElement>('[data-card-type]');
					if (type) type.textContent = card.typeLabel;

					const date = link.querySelector<HTMLTimeElement>('[data-card-date]');
					if (date) {
						date.dateTime = card.isoDate;
						date.textContent = card.dateLabel;
					}

					const title = link.querySelector<HTMLElement>('[data-card-title]');
					if (title) title.textContent = card.title;

					const category = link.querySelector<HTMLElement>('[data-card-category]');
					if (category) category.textContent = card.category;

					return link;
				};

				const finishBatch = (
					batch: { card: BoardMoreCard; position: Point; skeleton: HTMLElement }[],
				) => {
					batch.forEach(({ card, position, skeleton }) => {
						const node = makeCard(card, position);
						if (node) skeleton.replaceWith(node);
						else skeleton.remove();
					});

					board.classList.remove('is-loading');
					batchInFlight = false;
					lastBatchAt = Date.now();

					if (queueCursor >= moreQueue.length) {
						window.clearTimeout(endTimer);
						endTimer = window.setTimeout(placeEndCard, 360);
						return;
					}
				};

				const placeEndCard = () => {
					if (!canvasEnabled || endPlaced || !endTemplate || !cardLayer) return;
					const height = CARD_HEIGHT - 10;
					const view = viewRect();
					const boxes = obstacles();
					const centered = {
						x: (view.x0 + view.x1) / 2 - END_WIDTH / 2,
						y: (view.y0 + view.y1) / 2 - height / 2,
					};
					const centerBlocked = boxes.some(
						(box) =>
							centered.x < box.x + box.w + CARD_GAP &&
							centered.x + END_WIDTH + CARD_GAP > box.x &&
							centered.y < box.y + box.h + CARD_GAP &&
							centered.y + height + CARD_GAP > box.y,
					);
					const position = centerBlocked ? findRingPositions(1, END_WIDTH, height)[0] : centered;
					if (!position) {
						window.clearTimeout(endTimer);
						endTimer = window.setTimeout(placeEndCard, 900);
						return;
					}

					const fragment = endTemplate.content.cloneNode(true) as DocumentFragment;
					const node = fragment.querySelector<HTMLElement>('.board-card--end');
					if (!node) return;
					node.style.left = `${position.x}px`;
					node.style.top = `${position.y}px`;
					cardLayer.appendChild(node);
					endPlaced = true;
				};

				const startBatch = () => {
					if (!canvasEnabled || batchInFlight || !cardLayer) return;
					const cooldown = 140 - (Date.now() - lastBatchAt);
					if (cooldown > 0) {
						scheduleCheck(cooldown);
						return;
					}

					if (queueCursor >= moreQueue.length) {
						placeEndCard();
						return;
					}

					const items = moreQueue.slice(queueCursor);
					const positions = findRingPositions(items.length, MORE_WIDTH, CARD_HEIGHT);
					if (!positions.length) return;

					const batch: { card: BoardMoreCard; position: Point; skeleton: HTMLElement }[] = [];
					items.slice(0, positions.length).forEach((card, index) => {
						const position = positions[index];
						const skeleton = makeSkeleton(position);
						if (!skeleton) return;
						cardLayer.appendChild(skeleton);
						batch.push({ card, position, skeleton });
					});
					if (!batch.length) return;

					queueCursor += batch.length;
					batchInFlight = true;
					board.classList.add('is-loading');
					window.clearTimeout(batchTimer);
					batchTimer = window.setTimeout(() => finishBatch(batch), 120);
				};

				const scheduleCheck = (delay = 50) => {
					if (checkTimer) return;
					checkTimer = window.setTimeout(() => {
						checkTimer = 0;
						if (!canvasEnabled) return;
						if (batchInFlight) {
							scheduleCheck();
							return;
						}
						if (!shouldLoadNextRing()) return;
						startBatch();
					}, delay);
				};

				const clearDynamicCards = () => {
					window.clearTimeout(checkTimer);
					checkTimer = 0;
					window.clearTimeout(batchTimer);
					window.clearTimeout(endTimer);
					board.classList.remove('is-loading');
					batchInFlight = false;
					endPlaced = false;
					queueCursor = 0;
					nextRing = 1;
					lastBatchAt = 0;
					board.querySelectorAll('.board-card--more, .board-card--end').forEach((node) => node.remove());
				};

				const setScaleAt = (clientX: number, clientY: number, nextScale: number) => {
					if (!canvasEnabled) return;
					const clamped = Math.min(MAX_SCALE, Math.max(MIN_SCALE, nextScale));
					if (clamped === scale) return;

					const rect = board.getBoundingClientRect();
					const pointX = clientX - rect.left;
					const pointY = clientY - rect.top;
					const worldX = (pointX - offsetX) / scale;
					const worldY = (pointY - offsetY) / scale;

					scale = clamped;
					offsetX = pointX - worldX * scale;
					offsetY = pointY - worldY * scale;
					applyView();
					scheduleCheck();
				};

				const zoomBy = (factor: number) => {
					const rect = board.getBoundingClientRect();
					setScaleAt(rect.left + rect.width / 2, rect.top + rect.height / 2, scale * factor);
				};

				const resetView = () => {
					if (!canvasEnabled) return;
					scale = 1;
					offsetX = 0;
					offsetY = 0;
					applyView();
					scheduleCheck();
				};

				const movePan = (event: PointerEvent) => {
					if (activePointer !== event.pointerId) return;
					const deltaX = event.clientX - startX;
					const deltaY = event.clientY - startY;

					if (!moved && Math.hypot(deltaX, deltaY) > 4) {
						moved = true;
						board.classList.add('is-panning');
						document.body.classList.add('is-canvas-panning');
					}
					if (!moved) return;

					offsetX = startOffsetX + deltaX;
					offsetY = startOffsetY + deltaY;
					applyView();
					scheduleCheck();
				};

				const endPan = (event: PointerEvent) => {
					if (activePointer !== event.pointerId) return;
					window.removeEventListener('pointermove', movePan);
					window.removeEventListener('pointerup', endPan);
					window.removeEventListener('pointercancel', endPan);
					activePointer = null;
					board.classList.remove('is-panning');
					document.body.classList.remove('is-canvas-panning');

					if (moved) {
						suppressClick = true;
						window.setTimeout(() => {
							suppressClick = false;
						}, 60);
						scheduleCheck();
					}
					moved = false;
				};

				board.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => link.setAttribute('draggable', 'false'));

				board.addEventListener('pointerdown', (event) => {
					if (!canvasEnabled || activePointer !== null) return;
					if (event.pointerType === 'mouse' && event.button !== 0) return;

					const target = event.target as Element | null;
					if (
						target?.closest(
							'.board-zoom, .board-open, .board-search, button, input, textarea, select, [contenteditable="true"]',
						)
					) {
						return;
					}

					suppressClick = false;
					activePointer = event.pointerId;
					startX = event.clientX;
					startY = event.clientY;
					startOffsetX = offsetX;
					startOffsetY = offsetY;
					moved = false;
					window.addEventListener('pointermove', movePan);
					window.addEventListener('pointerup', endPan);
					window.addEventListener('pointercancel', endPan);
				});

				board.addEventListener(
					'click',
					(event) => {
						if (!suppressClick) return;
						event.preventDefault();
						event.stopPropagation();
						suppressClick = false;
					},
					true,
				);

				board.addEventListener(
					'wheel',
					(event) => {
						if (!canvasEnabled) return;
						event.preventDefault();

						if (event.ctrlKey || event.metaKey) {
							setScaleAt(event.clientX, event.clientY, scale * Math.exp(-event.deltaY * 0.0015));
							return;
						}

						const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? board.clientHeight : 1;
						offsetX -= event.deltaX * unit;
						offsetY -= event.deltaY * unit;
						applyView();
						scheduleCheck();
					},
					{ passive: false },
				);

				board.querySelector('[data-zoom-in]')?.addEventListener('click', () => zoomBy(1.15));
				board.querySelector('[data-zoom-out]')?.addEventListener('click', () => zoomBy(1 / 1.15));
				board.querySelector('[data-zoom-reset]')?.addEventListener('click', resetView);

				const syncCanvas = () => {
					canvasEnabled = canvasMedia.matches;
					board.classList.toggle('is-canvas', canvasEnabled);

					if (canvasEnabled) {
						applyView();
						scheduleCheck();
						return;
					}

					clearDynamicCards();
					scale = 1;
					offsetX = 0;
					offsetY = 0;
					activePointer = null;
					moved = false;
					world.style.transform = '';
					board.style.backgroundSize = '';
					board.style.backgroundPosition = '';
					zoomLabel.textContent = '100%';
					board.classList.remove('is-panning');
					document.body.classList.remove('is-canvas-panning');
					window.removeEventListener('pointermove', movePan);
					window.removeEventListener('pointerup', endPan);
					window.removeEventListener('pointercancel', endPan);
				};

				canvasMedia.addEventListener('change', syncCanvas);
				syncCanvas();
			}
		</script>
	</body>
</html>

