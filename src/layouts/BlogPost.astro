---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils/url';

type Props = CollectionEntry<'blog'>['data'] & { headings: MarkdownHeading[] };

const { title, description, pubDate, updatedDate, heroImage, category, tags, headings } = Astro.props;
const hasToc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length >= 2;

// 文章底部的前后篇导航
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const path = Astro.url.pathname.replace(/\/+$/, '');
const index = posts.findIndex((post) => path.endsWith(`/blog/${post.id}`));
const newer = index > 0 ? posts[index - 1] : null;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : null;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main class="article">
			<div class="article-shell">
				<div class="reading article-head">
					<a class="back-link" href={withBase('/blog')}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
						返回文章列表
					</a>

					<p class="eyebrow article-kicker">Reading · 文章</p>
					<h1 class="article-title reveal reveal--1">{title}</h1>
					<p class="article-desc reveal reveal--2">{description}</p>

					<div class="article-meta reveal reveal--3">
						<span class="meta-category">{category}</span>
						<span class="meta-sep"></span>
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<>
									<span class="meta-sep" />
									<span>更新于 <FormattedDate date={updatedDate} /></span>
								</>
							)
						}
					</div>
				</div>

				{
					heroImage && (
						<figure class="article-hero reveal reveal--3">
							<img width={1020} height={510} src={withBase(heroImage)} alt="" />
							<figcaption>Fig. 01 — {title}</figcaption>
						</figure>
					)
				}

				{hasToc && (
					<aside class="article-toc">
						<TableOfContents headings={headings} />
					</aside>
				)}

				<div class="reading prose">
					<slot />
				</div>

				<div class="reading article-end">
					<p class="end-mark" aria-hidden="true">· · ·</p>

					{
						tags.length > 0 && (
							<ul class="article-tags" aria-label="文章标签">
								{tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						)
					}

					{
						(newer || older) && (
							<nav class="post-nav" aria-label="文章导航">
								{older && (
									<a class="post-nav-item" href={withBase(`/blog/${older.id}/`)}>
										<span class="eyebrow">← 更早一篇</span>
										<span class="post-nav-title">{older.data.title}</span>
									</a>
								)}
								{newer && (
									<a class="post-nav-item is-right" href={withBase(`/blog/${newer.id}/`)}>
										<span class="eyebrow">更新一篇 →</span>
										<span class="post-nav-title">{newer.data.title}</span>
									</a>
								)}
							</nav>
						)
					}

					<a class="back-bottom" href={withBase('/blog')}>← 返回全部文章</a>
				</div>
			</div>
		</main>
		<Footer />
		<script>
			import '../scripts/diagrams.js';
		</script>
	</body>
</html>

<style>
	.article-head {
		padding: 3rem 0 2.5rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 3rem;
		color: var(--muted);
		font-size: 0.85rem;
		text-decoration: none;
		transition: color 0.2s ease, gap 0.25s var(--ease);
	}

	.back-link svg {
		width: 15px;
		height: 15px;
	}

	.back-link:hover {
		gap: 0.7rem;
		color: var(--accent);
	}

	.article-kicker {
		color: var(--accent);
	}

	.article-title {
		margin: 1rem 0 1.2rem;
		font-size: clamp(2.2rem, 5vw, 3.6rem);
		line-height: 1.2;
		letter-spacing: -0.035em;
	}

	.article-desc {
		margin: 0;
		color: var(--ink-soft);
		font-family: var(--font-serif);
		font-size: 1.2rem;
		line-height: 1.7;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem;
		margin-top: 1.8rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.82rem;
		letter-spacing: 0.03em;
	}

	.meta-sep {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--line-strong);
	}

	.meta-category {
		color: var(--accent);
		font-weight: 500;
		letter-spacing: 0.06em;
	}

	.article-hero {
		width: min(calc(100% - 2.5rem), 1000px);
		margin: 0 auto 3.5rem;
	}

	.article-hero img {
		width: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
	}

	.article-hero figcaption {
		margin-top: 0.7rem;
		color: var(--muted);
		font-family: var(--font-serif);
		font-size: 0.8rem;
		font-style: italic;
		letter-spacing: 0.04em;
		text-align: right;
	}

	.article-shell {
		position: relative;
	}

	.article-toc {
		width: min(calc(100% - 2.5rem), var(--reading));
		margin: 0 auto 2.8rem;
	}

	@media (min-width: 1260px) {
		.article-toc {
			position: absolute;
			top: 0;
			left: calc(50% + var(--reading) * 0.5 + 3rem);
			width: 196px;
			height: 100%;
			margin: 0;
			pointer-events: none;
		}

		.article-toc :global(.toc) {
			position: sticky;
			top: 6.5rem;
			pointer-events: auto;
		}
	}

	.article-end {
		margin-top: 3.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line-strong);
	}

	.end-mark {
		margin: 0 0 2rem;
		color: var(--accent);
		font-size: 1.4rem;
		letter-spacing: 0.6em;
		text-align: center;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 2.5rem;
		padding: 0;
		list-style: none;
	}

	.article-tags li {
		padding: 0.22rem 0.75rem;
		border: 1px solid var(--line-strong);
		border-radius: 100px;
		color: var(--muted);
		font-size: 0.72rem;
		letter-spacing: 0.05em;
	}

	.post-nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.post-nav-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.2rem 1.4rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		text-decoration: none;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.post-nav-item:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
	}

	.post-nav-item.is-right {
		grid-column: 2;
		text-align: right;
	}

	.post-nav-title {
		color: var(--ink);
		font-family: var(--font-serif);
		font-size: 1.15rem;
		line-height: 1.35;
	}

	.back-bottom {
		display: inline-block;
		color: var(--muted);
		font-size: 0.85rem;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.back-bottom:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.article-head {
			padding-top: 2rem;
		}
		.article-toc {
			width: calc(100% - 2rem);
			margin-bottom: 2.2rem;
		}
		.back-link {
			margin-bottom: 2rem;
		}
		.article-hero {
			width: calc(100% - 2rem);
			margin-bottom: 2.5rem;
		}
		.post-nav {
			grid-template-columns: 1fr;
			gap: 0.8rem;
		}
		.post-nav-item.is-right {
			grid-column: 1;
			text-align: left;
		}
	}
</style>
